# ==========================================
# TARK BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Application Port
PORT=3000
NODE_ENV=development

# ------------------------------------------
# DATABASE (Supabase PostgreSQL via Pooler)
# ------------------------------------------
# Supabase IPv4 Connection Pooler (London eu-west-2):
DATABASE_URL=postgresql://postgres.dousknjnueijzbmvecbn:YOUR_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# Database schema auto-sync (leave 'false' in production; 'true' only for local dev prototyping)
DB_SYNCHRONIZE=true
# Force SSL connection ('true' for remote databases, 'false' for local PostgreSQL)
DB_SSL=true

# ------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------
# Generate a strong value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse a value that was ever committed or shared.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# Number of reverse proxies in front of the app (Render, Cloudflare, etc.).
# Required in production so per-IP rate limiting sees real client IPs.
# Leave unset on localhost.
# TRUST_PROXY_HOPS=1

# ------------------------------------------
# PAYMENTS (Paystack - Primary Nigerian Gateway)
# ------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_placeholder_key

# Sandbox simulation for payments (transfers, bank checks, recipients).
# 'false' (default): any provider failure is a real error and nothing is marked paid.
# 'true': ONLY for local development with test keys; simulated results are returned
# instead of errors. It is always ignored when NODE_ENV=production.
PAYMENTS_SANDBOX_FALLBACK=false

# ------------------------------------------
# MEDIA & PROOF OF WORK STORAGE (iyke-storage / Cloudflare R2)
# ------------------------------------------
# Bucket: iyke-cloud -> tark/
STORAGE_GATEWAY_URL=https://iyke-storage-gateway.iyke-storage-gateway.workers.dev
STORAGE_API_KEY=ik_live_tark_xxxxxxxxxxxxxxxxxxxxxxxx
STORAGE_CUSTOM_CDN_URL=https://iyke-storage-gateway.iyke-storage-gateway.workers.dev/cdn

# ------------------------------------------
# GOOGLE GEMINI AI AGENT & TRIAGE DESK
# ------------------------------------------
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# ------------------------------------------
# NOTIFICATIONS & MULTI-CHANNEL DISPATCH
# ------------------------------------------
# Email Primary (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM="Tark <onboarding@resend.dev>"

# Email Fallback (Gmail SMTP / Standard SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Tark Protocol <your_email@gmail.com>"

# Web Push (Custom VAPID keys - no Firebase dependency)
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:support@tark.ng

# SMS Dispatch (Level 1: mock, Level 2: termii)
SMS_PROVIDER=mock
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=Tark
TERMII_ENVIRONMENT=sandbox

